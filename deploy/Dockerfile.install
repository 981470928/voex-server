ARG INSTALLER_BASE=nginx:latest
FROM ${INSTALLER_BASE}
ARG DEBIAN_MIRROR=https://mirrors.ustc.edu.cn
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=2 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.title="Voex complete installation bundle" \
      org.opencontainers.image.licenses="PolyForm-Noncommercial-1.0.0"
COPY artifacts/docker /usr/local/bin/docker
COPY artifacts/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
COPY artifacts/hub-release/ /release/
COPY installer-entrypoint.sh /usr/local/bin/voex-install
ENV DOCKER_CONFIG=/tmp/voex-installer-docker
ENTRYPOINT ["/usr/local/bin/voex-install"]
CMD []
